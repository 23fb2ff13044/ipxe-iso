#!ipxe
ifopen net0
ifstat


set net0/ip 192.168.20.115
set net0/netmask 255.255.255.0
#set net0/gateway 192.168.20.112
set net0/dns 192.168.20.101
set net0/domain kto.ges.local

set keep-san 1

set initiator-iqn iqn.2010-04.org.ipxe:${net0/mac:hexhyp}

#set net0/next-server 192.168.20.101
set root-path iscsi:192.168.20.106::::iqn.1992-08.com.netapp:2804.600a098000e00000000000005bea70ad
sanboot ${root-path} ||

#chain \boot\x86\wdsnbp.com ||
